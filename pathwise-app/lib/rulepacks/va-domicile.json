{
  "schema_version": 1,
  "pack_id": "va-domicile",
  "domain": "residency",
  "jurisdiction": "VA",
  "authority": "SCHEV Domicile Guidelines, Code of Virginia 23.1-510(D)",
  "source_url": "https://www.schev.edu/students/resources-for-students/paying-for-college/determining-domicile",
  "guidelines_effective": "2021-01-11",
  "verified_on": "2026-07-24",
  "agencies": [
    {
      "id": "schev",
      "name": "State Council of Higher Education for Virginia",
      "short_name": "SCHEV",
      "decides": ["residency"],
      "source_url": "https://www.schev.edu/students/resources-for-students/paying-for-college/determining-domicile"
    }
  ],
  "capabilities": [
    {
      "domain": "residency",
      "level": "modelled",
      "answers": [
        "status_gate",
        "durational_clock",
        "dependency_presumption",
        "intent_factors",
        "auxiliary_acts_warning",
        "rules_of_construction"
      ]
    }
  ],
  "volatility": {
    "status": "stable",
    "note": "SCHEV's statewide uniform criteria under Code of Virginia 23.1-510(D). The domicile provisions modelled in this pack were re-verified against the primary source on 2026-07-24."
  },
  "gates": [
    {
      "id": "eligible_alien_gate",
      "agency_id": "schev",
      "cite": "Part II, Section 03(A) & Section 02(4)",
      "display_cite": "SCHEV Pt II §03(A)",
      "when": "immigration.status in ['F1','J1','M1']",
      "result": "ineligible",
      "headline": "F-1 status blocks domicile in Virginia",
      "explain": "Holders of student or temporary visas do not have the capacity to establish domicile in Virginia.",
      "deciding_office": "domicile_officer",
      "stops_analysis": true
    }
  ],
  "clock": {
    "duration_days": 365,
    "anchor": "date_of_alleged_entitlement",
    "anchor_definition": "First official day of class of the term.",
    "start_rule": "date_of_last_qualifying_intent_factor",
    "start_rule_note": "The clock does NOT start on arrival; look at the date on which the LAST of the qualifying factors occurred.",
    "start_rule_cite": "Section 05(C)(1)"
  },
  "dependency": {
    "presumed_dependent_under_age": 24,
    "cite": "Section 09(C)(1)",
    "exceptions": [
      "veteran_or_active_duty",
      "graduate_or_professional_student",
      "married",
      "ward_of_court",
      "both_parents_deceased_no_guardian",
      "has_legal_dependents_other_than_spouse",
      "financial_self_sufficiency"
    ]
  },
  "intent_factors": [
    { "id": "continuous_residence", "weight": "primary" },
    { "id": "va_income_tax_filed", "weight": "primary" },
    { "id": "drivers_license", "weight": "secondary" },
    { "id": "voter_registration", "weight": "secondary", "inapplicable_when": "immigration.status != 'citizen'" },
    { "id": "employment", "weight": "primary", "caveat": "Co-op employment confers no domicile." },
    { "id": "va_job_offer_accepted", "weight": "primary" }
  ],
  "auxiliary_acts_warning": {
    "cite": "Section 06(B)",
    "note": "Acts auxiliary to educational objectives, or routinely performed by temporary residents, carry little weight.",
    "acts": ["drivers_license", "vehicle_registration", "post_admission_employment", "va_tax_filing"]
  },
  "construction_rules": [
    { "id": "favor_student_in_complex_cases", "kind": "favor_student_in_complex_cases", "cite": "SCHEV guidance", "note": "In complex cases, construe the facts in the light most favorable to the student." },
    { "id": "determinations_not_transferable", "kind": "determinations_not_transferable", "note": "A prior determination by one institution is not binding on another." },
    { "id": "parental_status_alone_insufficient", "kind": "parental_status_alone_insufficient", "note": "No student shall be denied in-state tuition solely because of parental status." }
  ]
}
